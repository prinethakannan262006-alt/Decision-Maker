# Decision Maker - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.

# Flask Application Settings
SECRET_KEY=replace-with-a-secure-random-secret-key
FLASK_ENV=production
DEBUG=False

# SQL Database Connection
# Local development default: sqlite:///decision_maker.db
# Render PostgreSQL default: postgresql://<username>:<password>@<hostname>:5432/<dbname>
DATABASE_URL=sqlite:///decision_maker.db

# MongoDB Atlas Connection (for chat logs and feedback)
# Optional: App operates gracefully in offline/fallback mode if omitted or unreachable
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/decision_maker?retryWrites=true&w=majority

# AI Assistant API Key (Google Gemini or Anthropic Claude)
# Optional: App uses built-in smart FAQ/error-code reasoning if not configured
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_API_KEY=your-ai-api-key-here

# Administrative Access Token (for protected ticket view and management)
ADMIN_TOKEN=your-secure-admin-token
